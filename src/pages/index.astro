---
import Panel from "../components/Panel.astro";
import Layout from "../layouts/Layout.astro";
import AboutMePanel from "../panels/AboutMePanel.astro";
import StartPanel from "../panels/StartPanel.astro";
import WorkPanel from "../panels/WorkPanel.astro";
import EducationPanel from "../panels/EducationPanel.astro";
import ProjectsPanel from "../panels/ProjectsPanel.astro";
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout>
	<div class="scene">
		<div class="helix">
			<div class="floor">footer</div>
			<StartPanel />
			<AboutMePanel />
			<WorkPanel />
			<EducationPanel />
			<ProjectsPanel />
		</div>
	</div>
</Layout>

<script>
	const panels = document.querySelectorAll(".panel");
	const panelCount = panels.length;
	document.documentElement.style.setProperty(
		"--panel-count",
		panelCount.toString(),
	);
	panels.forEach((panel, idx) =>
		(panel as HTMLElement).style.setProperty(
			"--panel-index",
			idx.toString(),
		),
	);
	var currentSlide = 0;
	function incrementSlide(delta: number) {
		currentSlide = (currentSlide + delta + panelCount) % panelCount;
		document.documentElement.style.setProperty(
			"--current-index",
			currentSlide.toString(),
		);
	}
	document.addEventListener("keydown", (e) => {
		if (e.key == "ArrowRight") {
			incrementSlide(1);
		} else if (e.key == "ArrowLeft") {
			incrementSlide(-1);
		}
	});
	var touchStartX: number;
	const touchThreshold = 50;
	document.addEventListener("touchstart", (e) => {
		touchStartX = e.changedTouches[0].screenX;
	});
	document.addEventListener("touchend", (e) => {
		const delta = e.changedTouches[0].screenX - touchStartX;
		if (delta > touchThreshold) {
			incrementSlide(1);
		} else if (delta < -1 * touchThreshold) {
			incrementSlide(-1);
		}
	});
</script>

<style lang="scss" is:global>
	:root {
		--grid-size: 2500px;
		--grid-square-size: 100px;
		--grid-large-square-size: calc(var(--grid-square-size) * 5);
		--panel-height: 60vh;
		--panel-width: 60vw;
		--panels-per-circle: 8.3;
		--panels-per-rainbow: 8.7;
		--panel-angular-width: calc(2 * pi / var(--panels-per-circle));
		--radius: calc(
			0.5 * var(--panel-width) / tan(var(--panel-angular-width) / 2)
		);
		--per-panel-vertical-offset: 25vh;
		--current-index: 0;
	}

	body {
		display: flex;
		justify-content: center;
		align-items: center;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
	}

	.scene {
		width: var(--panel-width);
		height: var(--panel-height);
		perspective: 1000px;
	}

	.helix {
		width: 100%;
		height: 100%;
		position: absolute;
		transform-style: preserve-3d;
		transition: transform 1s;
		transform: translateZ(calc(-1 * var(--radius)))
			rotateY(
				calc(
					1rad * -1 * var(--current-index) *
						var(--panel-angular-width)
				)
			)
			translateY(
				calc(var(--per-panel-vertical-offset) * var(--current-index))
			);
	}

	.floor {
		position: absolute;
		inset: calc(-2500px);
		overflow: visible;

		transform: rotateX(90deg) // Tilt 90 degrees so that it's perpendicular to the panels
			translateZ(calc(-1 * var(--panel-height) * 0.6)) // Push it down under the lowest panel
			rotateZ(
				17deg
			); // Rotate it a bit so that the grid lines don't line up with the first panel

		background-size:
			100% 100%,
			// size for distance fading overlay
			var(--grid-square-size) var(--grid-square-size),
			// Sizes for the horizonal & vertical thin lines
			var(--grid-square-size) var(--grid-square-size),
			var(--grid-large-square-size) var(--grid-large-square-size),
			// Sizes for the horizontal & vertical thick lines
			var(--grid-large-square-size) var(--grid-large-square-size);
		background-image:
			radial-gradient(circle, transparent 0%, white 90%),
			// distance fade overlay
			linear-gradient(to right, #818181 1px, transparent 1px),
			// thin horizontal lines
			linear-gradient(to bottom, #818181 1px, transparent 1px),
			// thin vertical lines
			linear-gradient(to right, #585858 4px, transparent 1px),
			// thick horizontal lines
			linear-gradient(
					to bottom,
					#585858 4px,
					transparent 1px
				); // thick vertical lines
	}
</style>
