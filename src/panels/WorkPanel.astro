---
import ListItem from "../components/ListItem.astro";
import Panel from "../components/Panel.astro";

function s(n: number) {
    if (n != 1) {
        return "s";
    } else {
        return "";
    }
}

function elapsed(year: number, month: number) {
    const start = new Date(year, month - 1, 1); // months in js are weirdly 0-indexed
    const end = new Date();
    const monthDiff =
        end.getMonth() -
        start.getMonth() +
        Math.max(1, 12 * (end.getFullYear() - start.getFullYear()));
    // Context for min(1,...): add 1 month when total months < 12
    // June 2025 - July 2026 is (7-6)+12 = 13 months (1yr 1mo)
    // June 2025 - July 2025 is (7-6)+0  = 1 month, but standard to write as 2
    // Oct 2024  - Feb 2026  is (2-10) + 24 = 16 months (1yr 4mo)
    // Oct 2025  - Feb 2026  is (2-10) + 12 = 4 months, but standard to write as 5
    const years = Math.floor(monthDiff / 12);
    const yearString = years >= 1 ? `${years} year${s(years)}` : "";
    const months = monthDiff % 12;
    const monthString = months >= 1 ? `${months} month${s(months)}` : "";
    const space = years > 0 && months > 0 ? " " : "";
    return yearString + space + monthString;
}
